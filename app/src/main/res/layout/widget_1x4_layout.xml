<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_1x4_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_widget_shape"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:weightSum="10">

    <!-- Option: Cycle 2 -->
    <Button
        android:id="@+id/btn_cycles_2"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="2"
        android:text="2 CK"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1E293B"
        android:textSize="9sp"
        android:textStyle="bold"
        android:layout_marginEnd="4dp"
        style="?android:attr/buttonStyleSmall" />

    <!-- Option: Cycle 3 -->
    <Button
        android:id="@+id/btn_cycles_3_1x4"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="2"
        android:text="3 CK"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1D4ED8"
        android:textSize="9sp"
        android:textStyle="bold"
        android:layout_marginEnd="4dp"
        style="?android:attr/buttonStyleSmall" />

    <!-- Option: Cycle 4 -->
    <Button
        android:id="@+id/btn_cycles_4_1x4"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="2"
        android:text="4 CK"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0369A1"
        android:textSize="9sp"
        android:textStyle="bold"
        android:layout_marginEnd="4dp"
        style="?android:attr/buttonStyleSmall" />

    <!-- Option: Set Biological Alarm (sets 5 recommended cycles or general active) -->
    <Button
        android:id="@+id/btn_set_bio_1x4"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="4"
        android:text="Đặt BT Sinh Học"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4F46E5"
        android:textSize="9sp"
        android:textStyle="bold"
        style="?android:attr/buttonStyleSmall" />

</LinearLayout>
