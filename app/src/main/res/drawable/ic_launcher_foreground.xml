<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Shadow effect path -->
    <path
        android:pathData="M 32,32 L 76,76 L 84,104 L 24,104 Z"
        android:fillType="nonZero">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="40"
                android:endX="80"
                android:endY="100"
                android:type="linear">
                <item android:color="#2A000000" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Custom Sleep alarm clock shape -->
    <path
        android:pathData="
            M 54,30 
            A 24,24 0 1,1 53.9,30 Z
            M 34,26
            A 8,8 0 1,1 44,18 L 34,26 Z
            M 64,18
            A 8,8 0 1,1 74,26 L 64,18 Z
            M 36,74
            L 28,82
            M 72,74
            L 80,82
            M 54,20
            L 54,26
        "
        android:strokeWidth="4"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Crescent Moon inside the clock representing sleep cycles -->
    <path
        android:pathData="M 46,44 a 10,10 0 1,0 14,14 a 13,13 0 1,1 -14,-14 z"
        android:fillType="nonZero">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="45"
                android:startY="45"
                android:endX="60"
                android:endY="60"
                android:type="linear">
                <item android:color="#F5F3FF" android:offset="0.0" /> <!-- Lavender glow -->
                <item android:color="#818CF8" android:offset="1.0" /> <!-- Indigo primary -->
            </gradient>
        </aapt:attr>
    </path>
</vector>
